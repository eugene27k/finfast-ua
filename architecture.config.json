  "modules": [
    {
      "id": "m-auth",
      "name": "Auth & Onboarding",
      "icon": "⚿",
      "color": "#4ade80",
      "col": 0,
      "row": 0,
      "sub": "Setup · login · session · Monobank token",
      "foot": "Точка входу",
      "description": "Точка входу і ідентифікації користувача: на /setup він уперше створює майстер-пароль (це створює зашифрований vault), потім на /login вводить пароль щоб розшифрувати БД для поточної сесії, і вже в Settings прив'язує свій Monobank токен. Усі інші модулі залежать від цього: без активної сесії БД зашифрована і недоступна, а без Monobank токена нема що синхронізувати."
    },
    {
      "id": "m-sync",
      "name": "Bank Sync",
      "icon": "⇅",
      "color": "#fbbf24",
      "col": 1,
      "row": 0,
      "sub": "Інтеграція з Monobank + Prisma persistence",
      "foot": "Постачальник транзакцій",
      "description": "Серце аппки: тягне з Monobank інформацію про рахунки, виписки за період та real-time webhook-и, і фоном зберігає все у SQLite через Prisma. Користувач натискає Refresh або відкриває Dashboard — і свіжі транзакції одразу з'являються всюди. Це постачальник даних, від якого живуть Categorization, Budgets, Analytics і Net Worth."
    },
    {
      "id": "m-ai",
      "name": "AI Assistant",
      "icon": "✦",
      "color": "#a78bfa",
      "col": 2,
      "row": 0,
      "sub": "Готовність до автоклассифікації",
      "foot": "Опційно",
      "description": "Інфраструктурний модуль: дозволяє користувачу зберегти власний OpenAI API ключ у своєму профілі, який пізніше використовуватиметься для автоматичного присвоєння категорій незрозумілим транзакціям. Зараз — опційний і не задіяний активно, але вже готовий розширити Categorization без зміни архітектури."
    },
    {
      "id": "m-cat",
      "name": "Categorization",
      "icon": "#",
      "color": "#f472b6",
      "col": 0,
      "row": 1,
      "sub": "MCC + custom + overrides",
      "foot": "Чим є кожна транзакція",
      "description": "Перетворює сирі банківські транзакції на щось зрозуміле: автоматично присвоює одну з 15 категорій за MCC-кодом, а коли користувач не згоден — створює власну категорію та override для конкретної транзакції. Це фундамент для Budgets (ліміти по категоріях) і Analytics (графіки витрат); без коректних категорій ці модулі мають мало сенсу."
    },
    {
      "id": "m-budg",
      "name": "Budgets",
      "icon": "◐",
      "color": "#60a5fa",
      "col": 1,
      "row": 1,
      "sub": "Ліміти · алерти · прогрес",
      "foot": "Контроль витрат",
      "description": "Дозволяє користувачу встановити місячні ліміти витрат по категоріях і отримувати попередження, коли він наближається або перевищує їх. Прогрес-картки показують стан кожного бюджета, а банер на Dashboard видає швидкий сигнал тривоги. Це інструмент самодисципліни — перетворює пасивний перегляд транзакцій на активне планування."
    },
    {
      "id": "m-anal",
      "name": "Analytics",
      "icon": "≋",
      "color": "#38bdf8",
      "col": 2,
      "row": 1,
      "sub": "Графіки витрат · порівняння",
      "foot": "Розуміння поведінки",
      "description": "Візуалізує фінансову поведінку: щоденна гістограма витрат, pie chart за категоріями, порівняння поточного місяця з минулим. Користувач приходить сюди щоб зрозуміти куди йдуть гроші і виявити тенденції — модуль не змінює даних, тільки агрегує. Це двигун сценаріїв \"щоденна перевірка\" і \"місячне планування\"."
    },
    {
      "id": "m-net",
      "name": "Net Worth & Accounts",
      "icon": "$",
      "color": "#c084fc",
      "col": 0,
      "row": 2,
      "sub": "Активи − пасиви, ручний облік",
      "foot": "Повна фінансова картина",
      "description": "Дозволяє додати поза-Monobank рахунки — депозити, кредити, готівку, інвестиції — як ручні asset/liability записи з власними транзакціями, і показує загальний чистий капітал (активи мінус пасиви). Робить аппку повноцінним фінансовим менеджером замість простого переглядача Monobank-виписки."
    },
    {
      "id": "m-cur",
      "name": "Currency & FX",
      "icon": "₴",
      "color": "#fb923c",
      "col": 1,
      "row": 2,
      "sub": "Мульти-валюта + кеш курсів",
      "foot": "Конверсії та формат",
      "description": "Обслуговує мульти-валютність: тягне курси з Monobank `/bank/currency` з кешем 5 хв, форматує суми з правильним символом валюти, конвертує значення для Net Worth і Analytics. Більшість користувачів про нього не думають — він мовчазно працює коли в когось є рахунки в EUR/USD або інвестиції в іноземних активах."
    },
    {
      "id": "m-io",
      "name": "Data I/O",
      "icon": "⇄",
      "color": "#f87171",
      "col": 2,
      "row": 2,
      "sub": "Експорт / Імпорт",
      "foot": "Резерв і перенос",
      "description": "Експорт і імпорт транзакцій у CSV/JSON: для бекапу, переїзду на нову інсталяцію або зовнішнього аналізу в Excel. Це модуль \"виходу з замкненої системи\" — гарантія, що дані користувача не залежать від цієї конкретної аппки і завжди залишаються його власністю."
    },
    {
      "id": "m-vault",
      "name": "Vault & Encryption",
      "icon": "⌬",
      "color": "#14b8a6",
      "col": 1,
      "row": 3,
      "sub": "SQLCipher whole-DB encryption",
      "foot": "Захист даних користувача",
      "description": "Реалізує password-derived шифрування цілої БД (SQLCipher): пароль користувача через KDF перетворюється на ключ, який тримається у пам'яті процесу тільки на час сесії, і саме ним розшифровується кожен запит Prisma через спеціальний адаптер. Жоден байт фінансових даних не лежить на диску у відкритому вигляді — без правильного пароля БД виглядає як шум, тому втрата пароля = втрата даних."
    }
  ],
