generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  monoToken String   @unique
  createdAt DateTime @default(now())

  categories      CustomCategory[]
  overrides       TransactionOverride[]
  transactions    Transaction[]
  manualAccounts  ManualAccount[]
}

model ManualAccount {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String   // "asset" | "liability"
  category     String   // "deposit" | "cash" | "investment" | "other-asset" | "installment" | "buy-in-parts" | "short-loan" | "mortgage" | "other-liability"
  currencyCode Int      @default(980)
  createdAt    DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id])
  transactions ManualTransaction[]

  @@unique([userId, name])
  @@index([userId])
}

model ManualTransaction {
  id              String   @id @default(cuid())
  manualAccountId String
  amount          Int      // in minor units (kopiyky), positive = income, negative = expense
  description     String
  time            Int      // unix timestamp
  createdAt       DateTime @default(now())

  account ManualAccount @relation(fields: [manualAccountId], references: [id], onDelete: Cascade)

  @@index([manualAccountId, time])
}

model CustomCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String
  createdAt DateTime @default(now())

  user      User                  @relation(fields: [userId], references: [id])
  overrides TransactionOverride[]

  @@unique([userId, name])
}

model TransactionOverride {
  id               String   @id @default(cuid())
  userId           String
  transactionId    String
  customCategoryId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  customCategory CustomCategory? @relation(fields: [customCategoryId], references: [id])

  @@unique([userId, transactionId])
}

model Transaction {
  id              String   @id
  userId          String
  accountId       String
  time            Int
  description     String
  mcc             Int
  originalMcc     Int
  hold            Boolean
  amount          Int
  operationAmount Int
  currencyCode    Int
  commissionRate  Int
  cashbackAmount  Int
  balance         Int
  comment         String?
  receiptId       String?
  invoiceId       String?
  counterEdrpou   String?
  counterIban     String?
  counterName     String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, accountId, time])
  @@index([userId, time])
}
